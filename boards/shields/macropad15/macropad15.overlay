/*
 * Macropad15 - shield cho ZMK firmware
 *
 * Phan cung: Pro Micro RP2040 (SparkFun), 15 phim ma tran 4x5 diode ROW2COL,
 * 3 nut xoay EC11 co nut nhan (nut nhan noi vao ma tran tai C4), OLED SSD1306
 * 128x64 I2C0 (SDA = GP20/D14, SCL = GP21/D10).
 *
 * Ban do ma tran (giong ban ESP32-C3 goc):
 *   - 15 phim Pn: hang n%4, cot n/4 (P0=R0C0 ... P14=R2C3, R3C3 trong)
 *   - Nut nhan encoder: ENC1 -> R0C4, ENC2 -> R1C4, ENC3 -> R2C4
 *     (3 chan con lai noi chung qua 1 diode vao C4)
 *   C0..C4 = GP7, GP8, GP29, GP28, GP4
 *   R0..R3 = GP1, GP0, GP2, GP3
 *   Encoder quay: ENC1 (GP5, GP6), ENC2 (GP26, GP27), ENC3 (GP22, GP23)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;

        /* Thu tu vi tri giong he LAYOUT() cua QMK: 15 phim roi 3 nut nhan encoder */
        map = <
            /* hang 1: k0..k4  */ RC(0,0) RC(1,0) RC(2,0) RC(3,0) RC(0,1)
            /* hang 2: k5..k9  */ RC(1,1) RC(2,1) RC(3,1) RC(0,2) RC(1,2)
            /* hang 3: k10..k14 */ RC(2,2) RC(3,2) RC(0,3) RC(1,3) RC(2,3)
            /* nut nhan ENC1, ENC2, ENC3 */ RC(0,4) RC(1,4) RC(2,4)
        >;
    };

    enc_1: enc_1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <4>;
        status = "okay";
    };

    enc_2: enc_2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <4>;
        status = "okay";
    };

    enc_3: enc_3 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <4>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&enc_1 &enc_2 &enc_3>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";

        /* Cot duoc quet (keo len), hang doc (keo xuong) */
        col-gpios = <&gpio0 7  GPIO_ACTIVE_HIGH>,
                    <&gpio0 8  GPIO_ACTIVE_HIGH>,
                    <&gpio0 29 GPIO_ACTIVE_HIGH>,
                    <&gpio0 28 GPIO_ACTIVE_HIGH>,
                    <&gpio0 4  GPIO_ACTIVE_HIGH>;
        row-gpios = <&gpio0 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };
};

/*
 * Board SparkFun Pro Micro RP2040 mac dinh bat uart0 (GP0/GP1), i2c1 (GP2/GP3),
 * spi0 (GP20/GP22/GP23) va adc (GP26..GP29) - tat ca deu dam chan qua ma tran,
 * encoder va OLED nen phai tat di.
 */
&uart0 { status = "disabled"; };
&i2c1  { status = "disabled"; };
&spi0  { status = "disabled"; };
&adc   { status = "disabled"; };

/* OLED SSD1306 128x64 tren I2C0: SDA = GP20, SCL = GP21 */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            pinmux = <I2C0_SDA_P20>, <I2C0_SCL_P21>;
            input-enable;
            bias-pull-up;
        };
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_FAST>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
