if SHIELD_MACROPAD15

config ZMK_KEYBOARD_NAME
    default "Macropad15"

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

# Man hinh mono 128x64
if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # ZMK_DISPLAY

endif # SHIELD_MACROPAD15
